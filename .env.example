# ════════════════════════════════════════════════════════════════
#  CodeSage AI — Frontend Environment Variables
#  Copy to .env and fill in your values.
# ════════════════════════════════════════════════════════════════

# ── Backend API ──────────────────────────────────────────────────
# URL of the running Express server
VITE_API_URL=http://localhost:3001

# ── v86 Linux VM ─────────────────────────────────────────────────
# Browser-side assets for the x86 VM host. Keep these as CDN or public static
# files served from your deployment.
VITE_V86_ASSET_BASE=https://cdn.jsdelivr.net/gh/copy/v86@master/build
VITE_V86_LINUX_IMAGE=https://raw.githubusercontent.com/copy/v86/master/images/linux3.iso
VITE_V86_EXEC_TIMEOUT=120000
VITE_V86_PROJECT_PATH=/workspace/project

# ── Supabase (frontend anon key — safe to expose) ────────────────
# Project URL:  Supabase Dashboard → Settings → API → Project URL
# Anon key:     Supabase Dashboard → Settings → API → anon (public)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
